# ===== JobHunter AI — variables de entorno =====
# Copiá este archivo a .env y completá los valores. Nunca subas .env a un repositorio.

# --- Núcleo (obligatorio en producción) ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ¡Guardala en un lugar seguro! Sin esta clave no se pueden leer los archivos cifrados.
FILE_ENCRYPTION_KEY=
# URL pública de la app (se usa en los links del informe por email)
APP_BASE_URL=http://localhost:8000
# Base de datos: SQLite por defecto. Para PostgreSQL: postgresql+psycopg://usuario:clave@host:5432/jobhunter
DATABASE_URL=
DATA_DIR=./data
# true si la app se sirve por HTTPS (cookies seguras)
COOKIE_SECURE=false
# Poné false después de crear tu cuenta para que nadie más pueda registrarse
ALLOW_REGISTRATION=true
# true = el scheduler corre dentro del proceso web (deploy de un solo proceso)
RUN_SCHEDULER_IN_WEB=false
TZ_DEFAULT=America/Argentina/Buenos_Aires

# --- IA: Claude (Anthropic) — análisis de CV, avisos y CV adaptados ---
# Obtener en https://console.anthropic.com/ → API Keys. Sin clave, la app usa análisis heurístico local.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Email saliente: informe diario (SMTP) ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu@gmail.com, SMTP_PASSWORD=<contraseña de aplicación>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

# --- Email entrante: alertas de LinkedIn, ZonaJobs, Computrabajo e Indeed (IMAP, solo lectura) ---
# Gmail: IMAP_HOST=imap.gmail.com, IMAP_USER=tu@gmail.com, IMAP_PASSWORD=<contraseña de aplicación>
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- APIs de empleo ---
# Jooble: clave gratuita en https://jooble.org/api/about
JOOBLE_API_KEY=
JOOBLE_API_URL=https://jooble.org/api/
# Careerjet: cuenta de partner en https://www.careerjet.com/partners/
CAREERJET_API_KEY=
CAREERJET_LOCALE=es_AR
CAREERJET_USER_IP=
